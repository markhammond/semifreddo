<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Semifreddo/Semifreddo.csproj" />
    <ProjectReference Include="../../src/Semifreddo.Testing/Semifreddo.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The host-side ZLinq bridge lives with the conformance suite; compiled in here too so both use one source. -->
    <PackageReference Include="ZLinq" Version="1.6.1" />
        <Compile Include="../../tests/Semifreddo.Conformance.Tests/ZLinqBridge.cs" Link="ZLinqBridge.cs" />
  </ItemGroup>
</Project>
